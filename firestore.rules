rules_version = '2';
// Nothing is readable or writable from a browser. The app talks to Firestore with a service-account key,
// and only ever stores AES-256-GCM encrypted backups (sm_backups/*).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
